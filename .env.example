# VoiceGuard — Environment Variables
# ⚠️  DO NOT commit this file to version control — add .env to .gitignore

# ── Speech-to-Text: Deepgram ──────────────────────────────
# Sign up at: https://console.deepgram.com/signup
# Free $200 credit, no credit card required
DEEPGRAM_API_KEY=paste_your_deepgram_key_here

# ── Voice Authenticity: Resemble AI ──────────────────────
# Sign up at: https://app.resemble.ai/
# Choose Flex (pay-as-you-go), $0.001/sec, no monthly fee
RESEMBLE_API_KEY=paste_your_resemble_key_here

# ── Pipeline Config ───────────────────────────────────────
CHUNK_DURATION_MS=4000
VITE_CHUNK_DURATION_MS=4000
UPLOAD_MAX_RETRIES=3
UPLOAD_TIMEOUT_MS=8000

# ── Score Fusion Weights (tunable in Week 3) ──────────────
WEIGHT_VOICE_AUTH=0.6
WEIGHT_LANGUAGE_RISK=0.4

# ── Risk Thresholds (tunable in Week 3) ──────────────────
THRESHOLD_GREEN_MAX=35
THRESHOLD_YELLOW_MAX=65
# RED = score > THRESHOLD_YELLOW_MAX

# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
